<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>ArchiveDex.Server</RootNamespace>
    <AssemblyName>ArchiveDex.Server</AssemblyName>
    <UserSecretsId>1d628a48-2b02-4e2c-be5f-7439b62f93cb</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <!-- The dev static-web-assets manifest records absolute Windows host paths, which do not
         exist inside the Linux debug container, so wwwroot would be served from the wrong place.
         Disable it and serve the physical (mounted) wwwroot via classic UseStaticFiles. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Card detection. Both native runtimes are referenced so the same build runs on a Windows
         dev machine and in the Linux container without a RID-specific publish. -->
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArchiveDex.Server.UnitTests" />
    <InternalsVisibleTo Include="ArchiveDex.Server.IntegrationTests" />
    <InternalsVisibleTo Include="ArchiveDex.Server.ContractTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- wwwroot is populated at build time by SyncAngularToWwwroot for local / Fast-mode serving.
         Exclude it from default Content so publish uses only the explicit PublishAngularClient copy
         (from obj/angular), avoiding NETSDK1152 "duplicate publish output files". Runtime serving
         reads the physical wwwroot via UseStaticFiles, which does not depend on Content items. -->
    <Content Remove="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="ai-pricing.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="card-set-references.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AngularInputs Include="ClientApp/src/**/*;ClientApp/package.json;ClientApp/package-lock.json;ClientApp/angular.json;ClientApp/tsconfig*.json" />
  </ItemGroup>

  <!-- Build the Angular client into obj/angular. Skipped inside Docker (BuildAngularClient=false;
       the image builds the client in its own stage) and incremental via Inputs/Outputs so an
       unchanged frontend does not rebuild on every F5. npm ci runs only when packages are missing. -->
  <Target Name="BuildAngularClient" BeforeTargets="Build"
          Condition="Exists('ClientApp/package-lock.json') AND '$(DesignTimeBuild)' != 'true' AND '$(BuildAngularClient)' != 'false'"
          Inputs="@(AngularInputs)"
          Outputs="obj/angular/browser/index.html">
    <Exec Command="npm ci --legacy-peer-deps" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp/node_modules')" />
    <Exec Command="npm run build -- --configuration development --output-path=&quot;$(MSBuildProjectDirectory)/obj/angular&quot;" WorkingDirectory="ClientApp" />
  </Target>

  <!-- Mirror the built client into wwwroot so it is served at runtime on a plain build
       (VS Fast-mode debug and local dotnet run), not only on publish. -->
  <Target Name="SyncAngularToWwwroot" AfterTargets="BuildAngularClient" BeforeTargets="Build"
          Condition="Exists('obj/angular/browser/index.html') AND '$(BuildAngularClient)' != 'false'">
    <ItemGroup>
      <_AngularBuilt Include="obj/angular/browser/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AngularBuilt)"
          DestinationFiles="@(_AngularBuilt->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Include the built client in the publish output (Docker / production). -->
  <Target Name="PublishAngularClient" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildAngularClient" Condition="Exists('obj/angular/browser/index.html')">
    <ItemGroup>
      <AngularDistFiles Include="obj/angular/browser/**/*" />
      <ResolvedFileToPublish Include="@(AngularDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
