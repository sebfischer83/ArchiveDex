@page "/design"
@* Dev-only living reference for design tokens & components.
   See specs/001-pokemon-card-manager/design/. Renders the gallery in
   light and a dark-scoped block so both themes are visible at once. *@

<PageTitle>ArchiveDex — Design Reference</PageTitle>

<div class="dp-page">
    <h1 class="dp-h1">ArchiveDex Design Reference</h1>
    <p class="ad-text-muted">Living token &amp; component gallery. Light first, dark scoped below.</p>

    <section class="dp-section">
        <h2 class="dp-h2">Theme: Light</h2>
        @Gallery
    </section>

    <section class="dp-section" data-theme="dark">
        <h2 class="dp-h2">Theme: Dark</h2>
        @Gallery
    </section>
</div>

@code {
    private RenderFragment Gallery => @<div class="dp-surface">
        @* --- color --- *@
        <h3 class="dp-h3">Surfaces &amp; text</h3>
        <div class="dp-row">
            <span class="dp-swatch" style="background:var(--ad-surface)">surface</span>
            <span class="dp-swatch" style="background:var(--ad-surface-sunk)">sunk</span>
            <span class="dp-swatch" style="background:var(--ad-surface-hover)">hover</span>
            <span class="dp-swatch" style="background:var(--ad-accent);color:var(--ad-text-onaccent)">accent</span>
            <span class="dp-swatch" style="background:var(--ad-accent-soft);color:var(--ad-accent)">accent-soft</span>
        </div>
        <div class="dp-row">
            <span style="color:var(--ad-text)">text</span>
            <span style="color:var(--ad-text-secondary)">secondary</span>
            <span style="color:var(--ad-text-muted)">muted</span>
            <span style="color:var(--ad-success)">success</span>
            <span style="color:var(--ad-warning)">warning</span>
            <span style="color:var(--ad-danger)">danger</span>
            <span style="color:var(--ad-info)">info</span>
        </div>

        @* --- type scale --- *@
        <h3 class="dp-h3">Type scale</h3>
        <div style="font-size:var(--ad-text-2xl);font-weight:var(--ad-weight-bold)">2xl — Hero / wizard</div>
        <div style="font-size:var(--ad-text-xl);font-weight:var(--ad-weight-bold)">xl — Page heading</div>
        <div style="font-size:var(--ad-text-lg);font-weight:var(--ad-weight-medium)">lg — Card title</div>
        <div style="font-size:var(--ad-text-base)">base — Body text 16px</div>
        <div style="font-size:var(--ad-text-sm)">sm — Secondary / cells</div>
        <div style="font-size:var(--ad-text-xs)">xs — Meta / chips</div>

        @* --- buttons --- *@
        <h3 class="dp-h3">Buttons</h3>
        <div class="dp-row">
            <button class="ad-btn ad-btn--primary">Add card</button>
            <button class="ad-btn ad-btn--secondary">Cancel</button>
            <button class="ad-btn ad-btn--ghost">Filter</button>
            <button class="ad-btn ad-btn--danger">Delete</button>
            <button class="ad-btn ad-btn--primary" disabled>Disabled</button>
        </div>

        @* --- chips --- *@
        <h3 class="dp-h3">Chips</h3>
        <div class="dp-row">
            <span class="ad-chip">×2</span>
            <span class="ad-chip ad-chip--accent">Best match</span>
            <span class="ad-chip ad-chip--success">Saved</span>
            <span class="ad-chip ad-chip--warning">Low confidence</span>
            <span class="ad-chip ad-chip--danger">Failed</span>
        </div>

        @* --- card grid --- *@
        <h3 class="dp-h3">Card grid (5:7)</h3>
        <div class="ad-grid">
            @for (var i = 0; i < 5; i++)
            {
                <div class="ad-card">
                    <div class="ad-card__art"></div>
                    <div class="ad-card__body">
                        <div class="ad-card__title">Charizard</div>
                        <div class="ad-card__meta">Base · 4/102</div>
                    </div>
                </div>
            }
        </div>

        @* --- elevation --- *@
        <h3 class="dp-h3">Elevation</h3>
        <div class="dp-row">
            <span class="dp-elev" style="box-shadow:var(--ad-shadow-sm)">sm</span>
            <span class="dp-elev" style="box-shadow:var(--ad-shadow-md)">md</span>
            <span class="dp-elev" style="box-shadow:var(--ad-shadow-lg)">lg</span>
        </div>
    </div>;
}

<style>
    .dp-page { max-width: var(--ad-content-max); margin: 0 auto; padding: var(--ad-space-6) var(--ad-space-4); }
    .dp-h1 { font-size: var(--ad-text-2xl); font-weight: var(--ad-weight-bold); }
    .dp-h2 { font-size: var(--ad-text-xl); font-weight: var(--ad-weight-bold); margin-top: var(--ad-space-6); }
    .dp-h3 { font-size: var(--ad-text-lg); font-weight: var(--ad-weight-medium); margin-top: var(--ad-space-5); }
    .dp-section[data-theme="dark"] { border-radius: var(--ad-radius-lg); }
    .dp-surface { background: var(--ad-surface-sunk); color: var(--ad-text); padding: var(--ad-space-5); border-radius: var(--ad-radius-lg); }
    .dp-row { display: flex; flex-wrap: wrap; gap: var(--ad-space-3); align-items: center; margin: var(--ad-space-3) 0; }
    .dp-swatch { display: inline-flex; align-items: center; justify-content: center; min-width: 90px; height: 56px; border-radius: var(--ad-radius-md); border: 1px solid var(--ad-border); font-size: var(--ad-text-xs); color: var(--ad-text); }
    .dp-elev { display: inline-flex; align-items: center; justify-content: center; width: 90px; height: 56px; border-radius: var(--ad-radius-md); background: var(--ad-surface); font-size: var(--ad-text-sm); }
</style>
