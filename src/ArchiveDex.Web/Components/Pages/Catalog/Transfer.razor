@page "/catalog/transfer"
@rendermode InteractiveServer
@using ArchiveDex.Application.Abstractions
@using ArchiveDex.Application.CatalogTransfer.Contracts
@using Hangfire
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@attribute [Authorize(Policy = "Administrator")]
@inject ICatalogTransferRepository Repository
@inject ICatalogTransferOrchestrator Orchestrator
@inject IBackgroundJobClient BackgroundJobs
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc
@implements IDisposable

<PageTitle>@Loc["CatalogTransfer.Title"]</PageTitle>

<h1 class="ad-heading">@Loc["CatalogTransfer.Title"]</h1>

@if (_error != null)
{
    <div class="ad-alert ad-alert-error">@_error</div>
}

@if (_activeOperation == null && !_isStarting)
{
    <div class="ad-card">
        <h2>@Loc["CatalogTransfer.ExportHeading"]</h2>
        <p>@Loc["CatalogTransfer.ExportDescription"]</p>
        <button type="button" class="ad-btn ad-btn-primary" @onclick="HandleStartExport" disabled="@_isStarting">
            @Loc["CatalogTransfer.ExportStart"]
        </button>
    </div>

    <div class="ad-card">
        <h2>@Loc["CatalogTransfer.ImportHeading"]</h2>
        <p>@Loc["CatalogTransfer.ImportDescription"]</p>
        <InputFile OnChange="HandleFileSelected" accept=".archivedex-catalog" />
        @if (_selectedFile != null)
        {
            <p class="ad-note">@string.Format(Loc["CatalogTransfer.SelectedFile"].Value, _selectedFile.Name, _selectedFile.Size / 1024)</p>
            <button type="button" class="ad-btn ad-btn-primary" @onclick="HandleValidateImport" disabled="@_isStarting">
                @Loc["CatalogTransfer.ValidatePackage"]
            </button>
        }
    </div>
}
else if (_activeOperation != null && _activeOperation.Status != "Completed")
{
    <div class="ad-card">
        <h2>@Loc["CatalogTransfer.StatusHeading"]</h2>
        <dl class="ad-dl">
            <dt>@Loc["CatalogTransfer.Kind"]</dt><dd>@(_activeOperation.Kind == "Export" ? Loc["CatalogTransfer.ExportStatus"] : Loc["CatalogTransfer.ImportStatus"])</dd>
            <dt>@Loc["CatalogTransfer.Status"]</dt><dd>@_activeOperation.Status</dd>
            <dt>@Loc["CatalogTransfer.Phase"]</dt><dd>@_activeOperation.Phase</dd>
            <dt>@Loc["CatalogTransfer.Records"]</dt><dd>@_activeOperation.ProcessedRecords / @_activeOperation.TotalRecords</dd>
            <dt>@Loc["CatalogTransfer.Images"]</dt><dd>@_activeOperation.ProcessedImages / @_activeOperation.TotalImages</dd>
            <dt>@Loc["CatalogTransfer.Errors"]</dt><dd>@_activeOperation.ErrorCount</dd>
        </dl>

        @if (_activeOperation.Status is "Running" or "Validating")
        {
            <button type="button" class="ad-btn ad-btn-warning" @onclick="HandleCancel">@Loc["CatalogTransfer.Cancel"]</button>
        }
        @if (_activeOperation.Kind == "Import"
            && _activeOperation.Status == "Validating"
            && _activeOperation.ValidationSucceeded == true)
        {
            <button type="button" class="ad-btn ad-btn-primary" @onclick="HandleStartImport" disabled="@_isStarting">
                @Loc["CatalogTransfer.StartImport"]
            </button>
        }
    </div>

    @if (_report != null && _report.Errors.Count > 0)
    {
        <div class="ad-card">
            <h3>@Loc["CatalogTransfer.WarningsErrors"]</h3>
            @foreach (var err in _report.Errors)
            {
                <div class="ad-alert ad-alert-warning">
                    <strong>@err.Code</strong>: @err.Message
                    @if (!string.IsNullOrWhiteSpace(err.RecommendedAction))
                    {
                        <p>→ @err.RecommendedAction</p>
                    }
                </div>
            }
        </div>
    }
}
else if (_activeOperation != null && _activeOperation.Status == "Completed")
{
    <div class="ad-card">
        <h2>@Loc["CatalogTransfer.Completed"]</h2>
        <dl class="ad-dl">
            <dt>@Loc["CatalogTransfer.Kind"]</dt><dd>@(_activeOperation.Kind == "Export" ? Loc["CatalogTransfer.ExportStatus"] : Loc["CatalogTransfer.ImportStatus"])</dd>
            <dt>@Loc["CatalogTransfer.Status"]</dt><dd>@_activeOperation.Status</dd>
            <dt>@Loc["CatalogTransfer.Records"]</dt><dd>@_activeOperation.ProcessedRecords / @_activeOperation.TotalRecords</dd>
            <dt>@Loc["CatalogTransfer.Images"]</dt><dd>@_activeOperation.ProcessedImages</dd>
            <dt>@Loc["CatalogTransfer.Errors"]</dt><dd>@_activeOperation.ErrorCount</dd>
        </dl>

        @if (_activeOperation.Kind == "Export" && _activeOperation.Status == "Completed")
        {
            <a class="ad-btn ad-btn-primary" href="/api/catalog-transfers/@_activeOperation.Id/package">
                @Loc["CatalogTransfer.DownloadPackage"]
            </a>
        }
    </div>
}
else if (_isStarting)
{
    <div class="ad-card">
        <p>@Loc["CatalogTransfer.Starting"]</p>
    </div>
}

@code {
    private CatalogTransferOperationDto? _activeOperation;
    private CatalogTransferReportDto? _report;
    private IBrowserFile? _selectedFile;
    private bool _isStarting;
    private string? _error;
    private PeriodicTimer? _timer;
    private Guid? _currentOperationId;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        while (_timer != null && await _timer.WaitForNextTickAsync())
        {
            await LoadStatusAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            var operation = _currentOperationId.HasValue
                ? await Repository.GetByIdAsync(_currentOperationId.Value)
                : await Repository.GetActiveOperationAsync();
            _currentOperationId ??= operation?.Id;
            _activeOperation = operation != null ? MapToDto(operation) : null;

            if (_activeOperation != null)
            {
                var errors = await Repository.GetErrorsByOperationIdAsync(_activeOperation.Id);
                _report = new CatalogTransferReportDto
                {
                    Operation = _activeOperation,
                    CategoryCounts = new Dictionary<string, long>(),
                    Errors = errors.Select(e => new CatalogTransferErrorDto
                    {
                        Code = e.Code, Check = e.Check, ItemPath = e.ItemPath,
                        Message = e.Message, Impact = e.Impact, RecommendedAction = e.RecommendedAction,
                        OccurredAt = e.OccurredAt,
                    }).ToList(),
                };
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task HandleStartExport()
    {
        _isStarting = true; _error = null; StateHasChanged();
        try
        {
            Guid operationId = await Orchestrator.StartExportAsync();
            _currentOperationId = operationId;
            _ = BackgroundJobs.Enqueue<ICatalogTransferExecutionService>(
                service => service.ExecuteExportAsync(operationId));
            await LoadStatusAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isStarting = false; StateHasChanged(); }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task HandleValidateImport()
    {
        if (_selectedFile == null) return;
        _isStarting = true; _error = null; StateHasChanged();
        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30L * 1024 * 1024 * 1024);
            Guid operationId = await Orchestrator.StartImportValidationAsync(stream, _selectedFile.Name);
            _currentOperationId = operationId;
            _ = BackgroundJobs.Enqueue<ICatalogTransferExecutionService>(
                service => service.ExecuteImportValidationAsync(operationId));
            await LoadStatusAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isStarting = false; _selectedFile = null; StateHasChanged(); }
    }

    private async Task HandleStartImport()
    {
        if (_activeOperation is null) return;
        _isStarting = true;
        _error = null;
        try
        {
            Guid operationId = _activeOperation.Id;
            await Orchestrator.StartImportRestoreAsync(operationId);
            _ = BackgroundJobs.Enqueue<ICatalogTransferExecutionService>(
                service => service.ExecuteImportRestoreAsync(operationId));
            await LoadStatusAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isStarting = false; StateHasChanged(); }
    }

    private async Task HandleCancel()
    {
        if (_activeOperation == null) return;
        try { await Orchestrator.CancelAsync(_activeOperation.Id); await LoadStatusAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static CatalogTransferOperationDto MapToDto(Domain.Entities.CatalogTransferOperation op) => new()
    {
        Id = op.Id, Kind = op.Kind.ToString(), Status = op.Status.ToString(), Phase = op.Phase.ToString(),
        PackageId = op.PackageId, FormatVersion = op.FormatVersion,
        StartedAt = op.StartedAt, FinishedAt = op.FinishedAt,
        ProcessedRecords = op.ProcessedRecords, TotalRecords = op.TotalRecords,
        ProcessedImages = op.ProcessedImages, TotalImages = op.TotalImages,
        ProcessedImageBytes = op.ProcessedImageBytes, TotalImageBytes = op.TotalImageBytes,
        ValidationSucceeded = op.ValidationSucceeded,
        ErrorCount = op.ErrorCount, WarningCount = op.WarningCount,
        CreatedAt = op.CreatedAt, UpdatedAt = op.UpdatedAt,
    };

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
