@page "/scan/confirm/{CardId:guid}"
@layout ArchiveDex.Web.Components.Layout.ScannerLayout
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ArchiveDex.Web.Services.ScannerSession Scanner
@inject IStringLocalizer<SharedResources> Loc

<div class="confirm-page">
    @if (Scanner.LastScanId is null)
    {
        <div class="empty-state">
            <p>@Loc["Scanner.CardNotFound"]</p>
            <button class="btn-back" @onclick="GoToScanHome">
                @Loc["Scanner.ScanAnother"]
            </button>
        </div>
    }
    else
    {
        var candidate = Scanner.Candidates.FirstOrDefault(c => c.CardId == Scanner.SelectedCardId);
        var cardName = candidate?.Name ?? Scanner.DetectedName ?? "Unknown";
        var cardNumber = candidate?.Number ?? Scanner.DetectedNumber ?? "";

        <button class="btn-nav-back" @onclick="GoToResults">
            <svg viewBox="0 0 24 24" class="back-icon"><path d="M15 18l-6-6 6-6"/></svg>
            @Loc["Scanner.ConfirmCard"]
        </button>

        <div class="card-preview">
            <h2 class="preview-name">@cardName</h2>
            <p class="preview-number">#@cardNumber</p>
        </div>

        <div class="confirm-form">
            <div class="form-group">
                <label class="form-label">@Loc["Scanner.Condition"]</label>
                <select @bind="_condition" class="form-select-native">
                    <option value="NearMint">Near Mint</option>
                    <option value="Excellent">Excellent</option>
                    <option value="Good">Good</option>
                    <option value="LightPlayed">Light Played</option>
                    <option value="Played">Played</option>
                    <option value="Poor">Poor</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">@Loc["Scanner.Quantity"]</label>
                <div class="quantity-control">
                    <button class="qty-btn" @onclick="() => _quantity = Math.Max(1, _quantity - 1)">-</button>
                    <span class="qty-value">@_quantity</span>
                    <button class="qty-btn" @onclick="() => _quantity++">+</button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">@Loc["Scanner.PurchasePrice"]</label>
                <input type="number" step="0.01" @bind="_purchasePrice"
                       class="form-input-native" placeholder="0.00" />
            </div>

            <div class="form-group">
                <label class="form-label">@Loc["Scanner.StorageLocation"]</label>
                <input type="text" @bind="_storageLocation"
                       class="form-input-native" placeholder="Binder A..." />
            </div>

            <div class="form-group">
                <label class="form-label">@Loc["Scanner.Notes"]</label>
                <input type="text" @bind="_notes"
                       class="form-input-native" placeholder="" />
            </div>
        </div>

        @if (_isConfirming)
        {
            <div class="confirming-overlay">
                <div class="spinner"></div>
                <p class="confirming-text">@Loc["Scanner.Processing"]</p>
            </div>
        }
        else if (_isAdded)
        {
            <div class="success-box">
                <div class="success-icon">&#10003;</div>
                <p class="success-text">@Loc["Scanner.AddedToCollection"]</p>
                <button class="btn-scan-next" @onclick="ScanNext">@Loc["Scanner.ScanNext"]</button>
            </div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-box">
                <p>@_error</p>
                <button class="btn-retry" @onclick="ResetError">@Loc["Scanner.ScanAnother"]</button>
            </div>
        }
        else
        {
            <button class="btn-confirm" @onclick="ConfirmAdd"
                    disabled="@_isConfirming">
                @Loc["Scanner.AddToCollection"]
            </button>
        }
    }
</div>

@code {
    private string _condition = "NearMint";
    private int _quantity = 1;
    private decimal? _purchasePrice;
    private string? _storageLocation;
    private string? _notes;
    private bool _isConfirming;
    private bool _isAdded;
    private string? _error;

    private void GoToScanHome()
    {
        Navigation.NavigateTo("/scan");
    }

    private void GoToResults()
    {
        Navigation.NavigateTo("/scan/result");
    }

    private void ResetError()
    {
        _error = null;
    }

    private async Task ConfirmAdd()
    {
        if (Scanner.SelectedCardId is null || Scanner.LastScanId is null) return;

        _isConfirming = true;
        _error = null;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"/api/scans/{Scanner.LastScanId}/confirm",
                new
                {
                    cardId = Scanner.SelectedCardId.Value,
                    condition = _condition,
                    quantity = _quantity,
                    purchasePrice = _purchasePrice,
                    storageLocation = _storageLocation,
                    notes = _notes
                });

            if (response.IsSuccessStatusCode)
            {
                _isAdded = true;
                Scanner.IsComplete = true;
            }
            else
            {
                _error = $"Failed to add: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isConfirming = false;
        }
    }

    private void ScanNext()
    {
        Scanner.Reset();
        Navigation.NavigateTo("/scan");
    }
}
