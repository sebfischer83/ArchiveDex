@page "/scan"
@layout ArchiveDex.Web.Components.Layout.ScannerLayout
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ArchiveDex.Web.Services.ScannerSession Scanner
@inject IStringLocalizer<SharedResources> Loc

<div class="scanner-home">
    <h1 class="scanner-title">@(Scanner.IsBatchMode ? "Batch Scan" : Loc["Scanner.TakePhoto"])</h1>

    <div class="scan-mode-toggle">
        <button class="mode-btn @(Scanner.IsBatchMode ? "" : "active")" @onclick="() => Scanner.IsBatchMode = false">Single</button>
        <button class="mode-btn @(Scanner.IsBatchMode ? "active" : "")" @onclick="() => Scanner.IsBatchMode = true">Batch</button>
    </div>

    @if (Scanner.IsBatchMode)
    {
        <div class="batch-upload-area">
            <InputFile OnChange="OnBatchFilesSelected"
                       accept="image/*"
                       class="camera-input-hidden"
                       id="batch-camera-input"
                       multiple />

            <label for="batch-camera-input" class="camera-button">
                <svg viewBox="0 0 24 24" class="camera-icon" aria-hidden="true">
                    <path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"/>
                    <path d="M9 2 7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9Zm3 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z"/>
                </svg>
            </label>

            @if (_batchFiles.Any())
            {
                <p class="batch-hint">@_batchFiles.Count image(s) selected</p>
                <button class="btn-primary" @onclick="UploadBatch">Upload Batch</button>
            }
            else
            {
                <p class="camera-hint">Select multiple card photos for batch scanning</p>
            }
        </div>

        @if (Scanner.IsScanning)
        {
            <div class="scanning-overlay">
                <div class="spinner"></div>
                <p class="scanning-text">Uploading @Scanner.BatchUploadProgress / @Scanner.BatchUploadTotal...</p>
                <progress class="scan-progress" value="@Scanner.BatchUploadProgress" max="@Scanner.BatchUploadTotal" />
            </div>
        }

        @if (!string.IsNullOrEmpty(Scanner.Error))
        {
            <div class="error-box">
                <p>@Scanner.Error</p>
                <button class="btn-retry" @onclick="ResetScan">Retry</button>
            </div>
        }
    }
    else
    {
        @if (Scanner.IsScanning)
        {
            <div class="scanning-overlay">
                <div class="spinner"></div>
                <p class="scanning-text">@Loc["Scanner.Uploading"]</p>
                <progress class="scan-progress" />
            </div>
        }
        else if (!string.IsNullOrEmpty(Scanner.Error))
        {
            <div class="error-box">
                <p>@Scanner.Error</p>
                <button class="btn-retry" @onclick="ResetScan">@Loc["Scanner.ScanAnother"]</button>
            </div>
        }
        else
        {
            <div class="camera-area">
                <InputFile OnChange="OnFileSelected"
                           accept="image/*"
                           class="camera-input-hidden"
                           id="camera-input" />

                <label for="camera-input" class="camera-button">
                    <svg viewBox="0 0 24 24" class="camera-icon" aria-hidden="true">
                        <path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"/>
                        <path d="M9 2 7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9Zm3 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z"/>
                    </svg>
                </label>
                <p class="camera-hint">@Loc["Scanner.TakePhoto"]</p>
            </div>
        }
    }
</div>

@code {
    private List<IBrowserFile> _batchFiles = [];

    private void OnBatchFilesSelected(InputFileChangeEventArgs e)
    {
        _batchFiles = e.GetMultipleFiles().ToList();
    }

    private async Task UploadBatch()
    {
        if (_batchFiles.Count < 2)
        {
            Scanner.Error = "At least 2 images are required for a batch scan.";
            return;
        }

        if (_batchFiles.Count > 50)
        {
            Scanner.Error = "Maximum 50 images per batch.";
            return;
        }

        Scanner.ResetBatch();
        Scanner.IsScanning = true;
        Scanner.BatchUploadTotal = _batchFiles.Count;
        Scanner.Error = null;

        try
        {
            using var content = new MultipartFormDataContent();
            for (int i = 0; i < _batchFiles.Count; i++)
            {
                var file = _batchFiles[i];
                var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "images", file.Name);
                Scanner.BatchUploadProgress = i + 1;
            }

            var response = await Http.PostAsync("/api/batch-scans", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BatchScanResponse>();
                if (result is not null)
                {
                    Scanner.ActiveBatchId = result.Id;
                    _batchFiles = [];
                    Navigation.NavigateTo($"/scan/batch/review/{result.Id}");
                }
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Scanner.Error = $"Batch scan failed: {response.StatusCode} - {errorBody}";
            }
        }
        catch (Exception ex)
        {
            Scanner.Error = ex.Message;
        }
        finally
        {
            Scanner.IsScanning = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        Scanner.Reset();
        Scanner.IsScanning = true;

        try
        {
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "image", file.Name);

            var response = await Http.PostAsync("/api/scans", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ScanUploadResponse>();
                if (result is not null)
                {
                    Scanner.LastScanId = result.Id;
                    Scanner.ImageUrl = result.ImageUrl;
                    Scanner.DetectedNumber = result.Ocr?.DetectedNumber;
                    Scanner.DetectedName = result.Ocr?.DetectedName;
                    Scanner.Confidence = result.Ocr?.Confidence;
                    Scanner.Candidates = result.Ocr?.Candidates?
                        .Select(c => new Services.CandidateItem
                        {
                            CardId = c.CardId,
                            Score = c.Score,
                            Number = c.Number,
                            Name = c.Name,
                            Rarity = c.Rarity,
                            CardLanguage = c.CardLanguage
                        }).ToList() ?? [];

                    Navigation.NavigateTo("/scan/result");
                }
            }
            else
            {
                Scanner.Error = $"Scan failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Scanner.Error = ex.Message;
        }
        finally
        {
            Scanner.IsScanning = false;
        }
    }

    private void ResetScan()
    {
        Scanner.Reset();
    }

    private class ScanUploadResponse
    {
        public Guid Id { get; set; }
        public string? Status { get; set; }
        public string? ImageUrl { get; set; }
        public OcrData? Ocr { get; set; }
    }

    private class OcrData
    {
        public string? DetectedNumber { get; set; }
        public string? DetectedName { get; set; }
        public double? Confidence { get; set; }
        public List<CandidateData>? Candidates { get; set; }
    }

    private class CandidateData
    {
        public Guid CardId { get; set; }
        public int Score { get; set; }
        public string Number { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Rarity { get; set; }
        public string? CardLanguage { get; set; }
    }

    private class BatchScanResponse
    {
        public Guid Id { get; set; }
        public string? Status { get; set; }
        public int ItemCount { get; set; }
        public int ErrorCount { get; set; }
    }
}
