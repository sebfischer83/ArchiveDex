@page "/scan/batch/accept/{BatchId:guid}"
@layout ArchiveDex.Web.Components.Layout.ScannerLayout
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="batch-accept ad-page ad-stack">
    <header class="ad-page-header">
        <div>
            <h1 class="ad-page-title">Accept Into Collection</h1>
            <p class="ad-page-subtitle">Choose the reviewed matches and collection details to save.</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="scanning-overlay">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="ad-error">
            <p>@_error</p>
        </div>
    }
    else if (_batch is not null)
    {
        <div class="ad-toolbar">
            <span><strong>@_batch.Batch?.Status</strong></span>
            <span>@_acceptedCount / @_batch.Items.Count(i => i.MatchStatus is "Matched" or "Overridden") accepted</span>
        </div>

        <div class="batch-defaults ad-panel">
            <div class="ad-panel__header">
                <h2 class="ad-section-title">Defaults</h2>
            </div>
            <div class="ad-panel__body ad-stack">
            <div class="form-row ad-form-grid">
                <label class="ad-field"><span class="ad-field__label">Condition</span>
                    <select class="ad-select" @bind="_defaultCondition">
                        <option value="NM">Near Mint</option>
                        <option value="LP">Lightly Played</option>
                        <option value="MP">Moderately Played</option>
                        <option value="HP">Heavily Played</option>
                        <option value="DMG">Damaged</option>
                    </select>
                </label>
                <label class="ad-field"><span class="ad-field__label">Quantity</span><input class="ad-input" type="number" min="1" @bind="_defaultQuantity" /></label>
                <label class="ad-field"><span class="ad-field__label">Price</span><input class="ad-input" type="number" step="0.01" @bind="_defaultPrice" /></label>
            </div>
            <div class="form-row ad-form-grid">
                <label class="ad-field"><span class="ad-field__label">Location</span><input class="ad-input" type="text" @bind="_defaultLocation" /></label>
                <label class="ad-field"><span class="ad-field__label">Notes</span><input class="ad-input" type="text" @bind="_defaultNotes" /></label>
            </div>
            </div>
        </div>

        <div class="accept-items ad-grid--rows">
            @foreach (var item in _batch.Items.Where(i => i.MatchStatus is "Matched" or "Overridden"))
            {
                <div class="accept-item ad-item-row @(_selectedItems.Contains(item.Id) ? "ad-item-row--selected selected" : "")">
                    <input type="checkbox" checked="@_selectedItems.Contains(item.Id)"
                           @onchange="(e) => ToggleItem(item.Id, (bool)(e.Value ?? false))" />
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Card" class="accept-item-img" />
                    }
                    else
                    {
                        <div class="accept-item-img missing-image">No image</div>
                    }
                    <div class="accept-item-info">
                        <span><strong>@item.MatchedCardName</strong> @item.MatchedCardNumber</span>
                        <div class="form-row ad-form-grid">
                            <label class="ad-field"><span class="ad-field__label">Condition</span>
                                <select class="ad-select" @bind="_itemConditions[item.Id]">
                                    <option value="">Default</option>
                                    <option value="NM">Near Mint</option>
                                    <option value="LP">Lightly Played</option>
                                    <option value="MP">Moderately Played</option>
                                    <option value="HP">Heavily Played</option>
                                    <option value="DMG">Damaged</option>
                                </select>
                            </label>
                            <label class="ad-field"><span class="ad-field__label">Quantity</span><input class="ad-input" type="number" min="1" @bind="_itemQuantities[item.Id]" /></label>
                            <label class="ad-field"><span class="ad-field__label">Price</span><input class="ad-input" type="number" step="0.01" @bind="_itemPrices[item.Id]" /></label>
                        </div>
                        <div class="form-row ad-form-grid">
                            <label class="ad-field"><span class="ad-field__label">Location</span><input class="ad-input" type="text" @bind="_itemLocations[item.Id]" /></label>
                            <label class="ad-field"><span class="ad-field__label">Notes</span><input class="ad-input" type="text" @bind="_itemNotes[item.Id]" /></label>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_showDuplicates && _duplicateConflicts.Count > 0)
        {
            <div class="duplicate-warnings ad-panel">
                <div class="ad-panel__body ad-stack">
                <h3 class="ad-section-title">Duplicates Detected</h3>
                @foreach (var dup in _duplicateConflicts)
                {
                    <p>@dup.CardName (@dup.Condition): already in collection. It will be skipped.</p>
                }
                <label class="ad-field"><span class="ad-field__label">Resolve duplicates</span>
                    <select class="ad-select" @bind="_duplicateAction">
                        <option value="skip">Keep skipped</option>
                        <option value="merge">Merge quantities</option>
                        <option value="separate">Create separate entries</option>
                    </select>
                </label>
                <button class="ad-btn ad-btn--primary" @onclick="SubmitAccept">Apply Duplicate Choice</button>
                </div>
            </div>
        }

        <div class="accept-actions ad-action-bar">
            <button class="ad-btn ad-btn--secondary" @onclick="SelectAll">Select All</button>
            <button class="ad-btn ad-btn--ghost" @onclick="DeselectAll">Deselect All</button>
            <button class="ad-btn ad-btn--primary" @onclick="SubmitAccept" disabled="@(!_selectedItems.Any() || _isSubmitting)">
                Accept @_selectedItems.Count Cards
            </button>
            <button class="ad-btn ad-btn--secondary" @onclick="GoBackToReview">Back to Review</button>
        </div>

        @if (_acceptResult is not null)
        {
            <div class="accept-result ad-panel">
                <div class="ad-panel__body ad-stack">
                <p>@_acceptResult.AcceptedCount cards added to collection.</p>
                @if (_acceptResult.AcceptedCount > 0)
                {
                    <button class="ad-btn ad-btn--primary" @onclick="GoToCollection">View Collection</button>
                }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid BatchId { get; set; }

    private BatchDetail? _batch;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _error;
    private string _defaultCondition = "NM";
    private int _defaultQuantity = 1;
    private string _defaultPrice = "";
    private string _defaultLocation = "";
    private string _defaultNotes = "";
    private HashSet<Guid> _selectedItems = [];
    private List<DuplicateConflict> _duplicateConflicts = [];
    private bool _showDuplicates;
    private AcceptResult? _acceptResult;
    private int _acceptedCount;
    private string _duplicateAction = "skip";
    private readonly Dictionary<Guid, string> _itemConditions = [];
    private readonly Dictionary<Guid, int?> _itemQuantities = [];
    private readonly Dictionary<Guid, string> _itemPrices = [];
    private readonly Dictionary<Guid, string> _itemLocations = [];
    private readonly Dictionary<Guid, string> _itemNotes = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadBatch();
    }

    private async Task LoadBatch()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var response = await Http.GetAsync($"/api/batch-scans/{BatchId}");
            if (response.IsSuccessStatusCode)
            {
                _batch = await response.Content.ReadFromJsonAsync<BatchDetail>();
                _selectedItems = [.. (_batch?.Items
                    .Where(i => i.MatchStatus is "Matched" or "Overridden")
                    .Select(i => i.Id) ?? [])];
                InitializeItemDetails();
            }
            else
            {
                _error = $"Failed to load batch: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleItem(Guid itemId, bool selected)
    {
        if (selected) _selectedItems.Add(itemId);
        else _selectedItems.Remove(itemId);
    }

    private void SelectAll()
    {
        if (_batch is not null)
        {
            _selectedItems = [.. _batch.Items
                .Where(i => i.MatchStatus is "Matched" or "Overridden")
                .Select(i => i.Id)];
        }
    }

    private void DeselectAll()
    {
        _selectedItems = [];
    }

    private void InitializeItemDetails()
    {
        if (_batch is null) return;

        foreach (var item in _batch.Items.Where(i => i.MatchStatus is "Matched" or "Overridden"))
        {
            _itemConditions.TryAdd(item.Id, string.Empty);
            _itemQuantities.TryAdd(item.Id, null);
            _itemPrices.TryAdd(item.Id, string.Empty);
            _itemLocations.TryAdd(item.Id, string.Empty);
            _itemNotes.TryAdd(item.Id, string.Empty);
        }
    }

    private async Task SubmitAccept()
    {
        _isSubmitting = true;
        _error = null;
        _duplicateConflicts = [];
        _showDuplicates = false;

        try
        {
            var body = new
            {
                defaults = new
                {
                    condition = _defaultCondition,
                    quantity = _defaultQuantity,
                    purchasePrice = string.IsNullOrEmpty(_defaultPrice) ? (decimal?)null : decimal.Parse(_defaultPrice),
                    storageLocation = string.IsNullOrEmpty(_defaultLocation) ? null : _defaultLocation,
                    notes = string.IsNullOrEmpty(_defaultNotes) ? null : _defaultNotes
                },
                items = _selectedItems.Select(id => new
                {
                    itemId = id,
                    condition = string.IsNullOrEmpty(_itemConditions.GetValueOrDefault(id)) ? null : _itemConditions[id],
                    quantity = _itemQuantities.GetValueOrDefault(id),
                    purchasePrice = string.IsNullOrEmpty(_itemPrices.GetValueOrDefault(id)) ? (decimal?)null : decimal.Parse(_itemPrices[id]),
                    storageLocation = string.IsNullOrEmpty(_itemLocations.GetValueOrDefault(id)) ? null : _itemLocations[id],
                    notes = string.IsNullOrEmpty(_itemNotes.GetValueOrDefault(id)) ? null : _itemNotes[id],
                    duplicateAction = _duplicateAction
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync($"/api/batch-scans/{BatchId}/accept", body);

            if (response.IsSuccessStatusCode)
            {
                _acceptResult = await response.Content.ReadFromJsonAsync<AcceptResult>();
                _acceptedCount = _acceptResult?.AcceptedCount ?? 0;
                _duplicateConflicts = _acceptResult?.DuplicateConflicts ?? [];
                _showDuplicates = _duplicateConflicts.Count > 0;
                _selectedItems = [];
                await LoadBatch();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflict = await response.Content.ReadFromJsonAsync<ConflictResponse>();
                _duplicateConflicts = conflict?.Conflicts ?? [];
                _showDuplicates = true;
            }
            else
            {
                _error = $"Accept failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class BatchDetail
    {
        public BatchInfo? Batch { get; set; }
        public List<BatchItem> Items { get; set; } = [];
    }

    private class BatchInfo
    {
        public string Status { get; set; } = string.Empty;
    }

    private class BatchItem
    {
        public Guid Id { get; set; }
        public string? ImageUrl { get; set; }
        public string MatchStatus { get; set; } = string.Empty;
        public string? MatchedCardName { get; set; }
        public string? MatchedCardNumber { get; set; }
    }

    private class AcceptResult
    {
        public int AcceptedCount { get; set; }
        public string BatchStatus { get; set; } = string.Empty;
        public List<DuplicateConflict> DuplicateConflicts { get; set; } = [];
    }

    private class DuplicateConflict
    {
        public string CardName { get; set; } = string.Empty;
        public string Condition { get; set; } = string.Empty;
    }

    private void GoToCollection()
    {
        Navigation.NavigateTo("/collection");
    }

    private void GoBackToReview()
    {
        Navigation.NavigateTo($"/scan/batch/review/{BatchId}");
    }

    private class ConflictResponse
    {
        public List<DuplicateConflict> Conflicts { get; set; } = [];
    }
}
