@page "/scan/batch/review/{BatchId:guid}"
@layout ArchiveDex.Web.Components.Layout.ScannerLayout
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ArchiveDex.Web.Services.ScannerSession Scanner

<div class="batch-review">
    <h1>Batch Review</h1>

    @if (_isLoading)
    {
        <div class="scanning-overlay">
            <div class="spinner"></div>
            <p>Loading batch...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-box">
            <p>@_error</p>
            <button class="btn-retry" @onclick="LoadBatch">Retry</button>
        </div>
    }
    else if (_batch is not null)
    {
        <div class="batch-status-bar">
            <span>Status: <strong>@_batch.Batch?.Status</strong></span>
            <span>@_batch.Batch?.AcceptedCount accepted / @_batch.Batch?.RejectedCount rejected / @_batch.Batch?.NoMatchCount no match</span>
            <span>@_batch.Batch?.PendingCount left</span>
        </div>

        <div class="status-filter">
            <button class="filter-btn @(_statusFilter == "all" ? "active" : "")" @onclick="SetFilterAll">All</button>
            <button class="filter-btn @(_statusFilter == "low-confidence" ? "active" : "")" @onclick="SetFilterLowConfidence">Low Confidence</button>
            <button class="filter-btn @(_statusFilter == "no-match" ? "active" : "")" @onclick="SetFilterNoMatch">No Match</button>
            <button class="filter-btn @(_statusFilter == "needs-review" ? "active" : "")" @onclick="SetFilterNeedsReview">Needs Review</button>
            <button class="filter-btn @(_statusFilter == "reviewed" ? "active" : "")" @onclick="SetFilterReviewed">Reviewed</button>
        </div>

        <div class="batch-items-grid">
            @foreach (var item in _items)
            {
                <div class="batch-item-card @(item.IsDuplicateInBatch ? "duplicate" : "")" @onclick="() => ViewItemDetail(item)">
                    <img src="@item.ImageUrl" alt="Card" class="batch-item-img" />
                    <div class="batch-item-info">
                        <span class="match-status @item.MatchStatus.ToLowerInvariant()">@item.MatchStatus</span>
                        @if (item.DetectedName is not null)
                        {
                            <span class="detected-name">@item.DetectedName</span>
                        }
                        @if (item.Confidence.HasValue)
                        {
                            <span class="confidence @(item.Confidence < 0.5 ? "low" : "")">@item.Confidence.Value.ToString("P0")</span>
                        }
                        @if (item.MatchedCardName is not null)
                        {
                            <span class="matched-card">@item.MatchedCardName @item.MatchedCardNumber</span>
                        }
                        @if (item.IsDuplicateInBatch)
                        {
                            <span class="duplicate-warning">⚠ Duplicate</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_selectedItem is not null)
        {
            <div class="item-detail-overlay" @onclick="() => _selectedItem = null">
                <div class="item-detail-panel" @onclick:stopPropagation="true">
                    <h2>Item Detail</h2>
                    <img src="@_selectedItem.ImageUrl" alt="Card" class="detail-img" />
                    <div class="ocr-details">
                        <p><strong>OCR:</strong> @_selectedItem.DetectedName (@_selectedItem.DetectedNumber)</p>
                        <p><strong>Confidence:</strong> @(_selectedItem.Confidence?.ToString("P0") ?? "N/A")</p>
                        <p><strong>Status:</strong> @_selectedItem.MatchStatus</p>
                    </div>

                    <div class="action-buttons">
                        <button class="btn-primary" @onclick="() => _showCatalogSearch = !_showCatalogSearch">
                            @(_selectedItem.MatchedCardPrintId is not null ? "Change Match" : "Find Match")
                        </button>
                        <button class="btn-secondary" @onclick="MarkNoMatch">Mark No Match</button>
                        <button class="btn-secondary" @onclick="() => _selectedItem = null">Close</button>
                    </div>

                    @if (_showCatalogSearch && _selectedItem is not null)
                    {
                        <div class="catalog-search">
                            <input type="text" @bind="_catalogSearchQuery" placeholder="Search catalog..." />
                            <button class="btn-primary" @onclick="SearchCatalog">Search</button>

                            @if (_catalogResults.Any())
                            {
                                <div class="catalog-results">
                                    @foreach (var card in _catalogResults)
                                    {
                                        <div class="catalog-result-item" @onclick="() => AssignCard(card)">
                                            <span>@card.Number - @card.Name</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_itemError is not null)
                    {
                        <div class="error-box"><p>@_itemError</p></div>
                    }
                </div>
            </div>
        }

        @if (_batch.Batch?.PendingCount > 0 && _batch.Items.Any(i => i.MatchStatus is "Matched" or "Overridden"))
        {
            <div class="batch-actions">
                <button class="btn-accept" @onclick="GoToAccept">Accept Into Collection</button>
                <button class="btn-discard" @onclick="DiscardBatch">Discard Batch</button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid BatchId { get; set; }

    private BatchDetail? _batch;
    private List<BatchItemSummary> _items = [];
    private BatchItemSummary? _selectedItem;
    private bool _isLoading = true;
    private string? _error;
    private string? _itemError;
    private string _statusFilter = "all";
    private bool _showCatalogSearch;
    private string _catalogSearchQuery = string.Empty;
    private List<CatalogCard> _catalogResults = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadBatch();
    }

    private async Task LoadBatch()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var url = $"/api/batch-scans/{BatchId}";
            if (_statusFilter != "all")
            {
                url += $"?statusFilter={_statusFilter}";
            }

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadFromJsonAsync<BatchDetail>();
                _batch = detail;
                _items = detail?.Items ?? [];
            }
            else
            {
                _error = $"Failed to load batch: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetFilter(string filter)
    {
        _statusFilter = filter;
        await LoadBatch();
    }

    private async Task SetFilterAll() => await SetFilter("all");
    private async Task SetFilterLowConfidence() => await SetFilter("low-confidence");
    private async Task SetFilterNoMatch() => await SetFilter("no-match");
    private async Task SetFilterNeedsReview() => await SetFilter("needs-review");
    private async Task SetFilterReviewed() => await SetFilter("reviewed");

    private async void ViewItemDetail(BatchItemSummary item)
    {
        _selectedItem = item;
        _showCatalogSearch = false;
        _itemError = null;

        try
        {
            var response = await Http.GetAsync($"/api/batch-scans/{BatchId}/items/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadFromJsonAsync<BatchItemDetail>();
                if (detail is not null)
                {
                    item.MatchedCardPrintId = detail.MatchedCardPrintId;
                    item.MatchStatus = detail.MatchStatus;
                    item.IsReviewed = true;
                }
            }
        }
        catch { }
    }

    private async Task SearchCatalog()
    {
        if (string.IsNullOrWhiteSpace(_catalogSearchQuery)) return;

        try
        {
            var response = await Http.GetAsync($"/api/catalog/cards?query={Uri.EscapeDataString(_catalogSearchQuery)}&page=1&pageSize=10");
            if (response.IsSuccessStatusCode)
            {
                _catalogResults = await response.Content.ReadFromJsonAsync<List<CatalogCard>>() ?? [];
            }
        }
        catch (Exception ex)
        {
            _itemError = ex.Message;
        }
    }

    private async Task AssignCard(CatalogCard card)
    {
        if (_selectedItem is null) return;

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"/api/batch-scans/{BatchId}/items/{_selectedItem.Id}/match",
                new { cardPrintId = card.Id });

            if (response.IsSuccessStatusCode)
            {
                _selectedItem.MatchedCardPrintId = card.Id;
                _selectedItem.MatchStatus = "Overridden";
                _selectedItem.MatchedCardName = card.Name;
                _selectedItem.MatchedCardNumber = card.Number;
                _showCatalogSearch = false;
                _catalogResults = [];
                StateHasChanged();
            }
            else
            {
                _itemError = "Failed to assign card.";
            }
        }
        catch (Exception ex)
        {
            _itemError = ex.Message;
        }
    }

    private async Task MarkNoMatch()
    {
        if (_selectedItem is null) return;

        try
        {
            var response = await Http.PutAsync(
                $"/api/batch-scans/{BatchId}/items/{_selectedItem.Id}/no-match", null);

            if (response.IsSuccessStatusCode)
            {
                _selectedItem.MatchStatus = "NoMatch";
                _selectedItem.IsDuplicateInBatch = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _itemError = ex.Message;
        }
    }

    private void GoToAccept()
    {
        Navigation.NavigateTo($"/scan/batch/accept/{BatchId}");
    }

    private async Task DiscardBatch()
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/batch-scans/{BatchId}");
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/scan");
            }
            else
            {
                _error = "Failed to discard batch.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private class BatchDetail
    {
        public BatchInfo? Batch { get; set; }
        public List<BatchItemSummary> Items { get; set; } = [];
    }

    private class BatchInfo
    {
        public Guid Id { get; set; }
        public string Status { get; set; } = string.Empty;
        public int ItemCount { get; set; }
        public int AcceptedCount { get; set; }
        public int RejectedCount { get; set; }
        public int NoMatchCount { get; set; }
        public int PendingCount { get; set; }
    }

    private class BatchItemSummary
    {
        public Guid Id { get; set; }
        public string ImageUrl { get; set; } = string.Empty;
        public string MatchStatus { get; set; } = string.Empty;
        public bool IsReviewed { get; set; }
        public string? DetectedName { get; set; }
        public string? DetectedNumber { get; set; }
        public float? Confidence { get; set; }
        public string? MatchedCardName { get; set; }
        public string? MatchedCardNumber { get; set; }
        public bool IsDuplicateInBatch { get; set; }
        public Guid? MatchedCardPrintId { get; set; }
    }

    private class BatchItemDetail
    {
        public Guid? MatchedCardPrintId { get; set; }
        public string MatchStatus { get; set; } = string.Empty;
    }

    private class CatalogCard
    {
        public Guid Id { get; set; }
        public string Number { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }
}
