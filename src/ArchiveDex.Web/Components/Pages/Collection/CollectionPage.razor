@page "/collection"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc
@using System.Net.Http.Json

<div class="collection-page">

    <h1 class="page-title">@Loc["Nav.Collection"]</h1>

    <div class="filter-bar">
        <div class="filter-field">
            <label class="filter-label" for="lang-filter">Language</label>
            <select id="lang-filter" class="filter-select" value="@_selectedLanguage" @onchange="OnLanguageChanged">
                <option value="">All languages</option>
                @foreach (var language in _languages)
                {
                    <option value="@language">@language</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label class="filter-label" for="set-filter">Set</label>
            <select id="set-filter" class="filter-select" value="@_selectedSetId" @onchange="OnSetChanged" disabled="@_isLoadingSets">
                <option value="">All sets</option>
                @foreach (var set in FilteredSets)
                {
                    <option value="@set.SetId">@set.Name (@set.CardLanguage)</option>
                }
            </select>
        </div>
        <button type="button" class="ad-btn ad-btn--ghost" @onclick="LoadSets" disabled="@_isLoadingSets">
            @(_isLoadingSets ? "Refreshing…" : "Refresh sets")
        </button>
    </div>

    <div class="search-bar">
        <InputText id="search" @bind-Value="_searchQuery" class="search-input" placeholder="@_searchPlaceholder" />
        <button class="ad-btn ad-btn--primary" @onclick="Search" disabled="@_isLoading">
            @Loc["App.Search"]
        </button>
    </div>

    <div class="collection-grid">
        @if (_isLoading)
        {
            @for (var i = 0; i < 10; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-art"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line"></div>
                        <div class="skeleton-line skeleton-line--short"></div>
                    </div>
                </div>
            }
        }
        else if (_entries is not null && _entries.Count > 0)
        {
            @foreach (var entry in _entries)
            {
                <div class="coll-card" tabindex="0" role="button" aria-label="@entry.CardName">
                    <div class="card-art-wrap">
                        @if (!string.IsNullOrWhiteSpace(entry.FrontImageUrl))
                        {
                            <img class="card-art" src="@entry.FrontImageUrl" alt="@entry.CardName" loading="lazy" />
                        }
                        else
                        {
                            <img class="card-art-placeholder" src="/card-placeholder.svg" alt="" />
                        }
                        @if (entry.Quantity > 1)
                        {
                            <span class="card-qty-badge">&times;@entry.Quantity</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="card-name">@entry.CardName</div>
                        <div class="card-meta">
                            <span class="cond-chip">@entry.Condition</span>
                            @if (entry.PurchasePrice.HasValue)
                            {
                                <span>@entry.PurchasePrice.Value.ToString("C")</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-state">@_error</div>
        }
        else if (_entries is not null)
        {
            <div class="empty-state">
                <p class="empty-state-title">No cards here</p>
                <p class="empty-state-desc">@CurrentSelectionTitle returned no results. Try a different filter or scan a card.</p>
                <a class="ad-btn ad-btn--primary" href="/scan">Scan a card</a>
            </div>
        }
    </div>

</div>

@code {
    private string _searchQuery = string.Empty;
    private string _selectedLanguage = string.Empty;
    private string _selectedSetId = string.Empty;
    private string _searchPlaceholder => Loc["App.Search"] + "...";
    private List<CollectionEntryDto>? _entries;
    private List<CollectionSetDto> _sets = [];
    private string? _error;
    private bool _isLoading;
    private bool _isLoadingSets;
    private readonly string[] _languages = ["de", "en", "ja", "ko", "zh-Hans", "zh-Hant"];

    private IEnumerable<CollectionSetDto> FilteredSets =>
        string.IsNullOrWhiteSpace(_selectedLanguage)
            ? _sets
            : _sets.Where(s => string.Equals(s.CardLanguage, _selectedLanguage, StringComparison.OrdinalIgnoreCase));

    private string CurrentSelectionTitle
    {
        get
        {
            var set = SelectedSet;
            if (set is not null) return $"{set.Name} ({set.CardLanguage})";
            return string.IsNullOrWhiteSpace(_selectedLanguage)
                ? "All collection cards"
                : $"All {_selectedLanguage} collection cards";
        }
    }

    private CollectionSetDto? SelectedSet =>
        Guid.TryParse(_selectedSetId, out var setId)
            ? _sets.FirstOrDefault(s => s.SetId == setId)
            : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadSets();
        await Search();
    }

    private async Task LoadSets()
    {
        _isLoadingSets = true;
        try
        {
            _sets = await Http.GetFromJsonAsync<List<CollectionSetDto>>("/api/collection/sets") ?? [];
            if (!string.IsNullOrWhiteSpace(_selectedSetId) &&
                !_sets.Any(s => s.SetId.ToString() == _selectedSetId))
            {
                _selectedSetId = string.Empty;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoadingSets = false;
        }
    }

    private async Task ApplyFilters()
    {
        await Search();
    }

    private async Task OnLanguageChanged(ChangeEventArgs args)
    {
        _selectedLanguage = args.Value?.ToString() ?? string.Empty;
        _selectedSetId = string.Empty;
        await Search();
    }

    private async Task OnSetChanged(ChangeEventArgs args)
    {
        _selectedSetId = args.Value?.ToString() ?? string.Empty;
        await Search();
    }

    private async Task Search()
    {
        _error = null;
        _isLoading = true;
        try
        {
            var query = "/api/collection?page=1";
            if (SelectedSet is not null)
                query += $"&setId={SelectedSet.SetId}";
            if (!string.IsNullOrWhiteSpace(_selectedLanguage))
                query += $"&cardLanguage={Uri.EscapeDataString(_selectedLanguage)}";
            if (!string.IsNullOrWhiteSpace(_searchQuery))
                query += $"&q={Uri.EscapeDataString(_searchQuery)}";
            _entries = await Http.GetFromJsonAsync<List<CollectionEntryDto>>(query);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private record CollectionEntryDto(Guid Id, string CardName, string Condition, int Quantity,
        decimal? PurchasePrice, string? StorageLocation, string? Notes, string? FrontImageUrl, DateTime? DateAdded);

    private record CollectionSetDto(
        Guid SetId,
        string Name,
        string CardLanguage,
        int UniqueCards,
        int TotalQuantity);
}
