@page "/collection/card/{Id:guid}"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc
@using System.Net.Http.Json
@using ArchiveDex.Application.Queries.Catalog

<div class="detail-page">

    @if (_isLoading)
    {
        <div class="detail-skeleton">
            <div class="skel-art"></div>
            <div class="skel-info">
                <div class="skeleton-line skel-title"></div>
                <div class="skeleton-line skel-sub"></div>
                <div class="skeleton-line skel-sub skel-sub--short"></div>
            </div>
        </div>
    }
    else if (_entry is null)
    {
        <div class="detail-error">
            <p>Card not found in your collection.</p>
            <button class="ad-btn ad-btn--secondary" type="button" @onclick="GoBack">← Back to collection</button>
        </div>
    }
    else
    {
        <div class="detail-back">
            <button class="ad-btn ad-btn--ghost" type="button" @onclick="GoBack">← @Loc["Nav.Collection"]</button>
        </div>

        <div class="detail-layout">

            @* ── Left: art ── *@
            <aside class="detail-art-col">
                <div class="detail-art-wrap">
                    @{ var imageUrl = _entry.FrontImageUrl ?? _card?.ImageUrl; }
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img class="detail-art" src="@imageUrl" alt="@_entry.CardName" />
                    }
                    else
                    {
                        <img class="detail-art-placeholder" src="/card-placeholder.svg" alt="" />
                    }
                </div>

                @if (_card is not null)
                {
                    <div class="variant-chips">
                        @if (_card.VariantNormal)    { <span class="ad-chip">Normal</span> }
                        @if (_card.VariantHolo)      { <span class="ad-chip ad-chip--accent">Holo</span> }
                        @if (_card.VariantReverse)   { <span class="ad-chip">Reverse Holo</span> }
                        @if (_card.VariantFirstEdition) { <span class="ad-chip ad-chip--warning">1st Edition</span> }
                    </div>

                    @if (_card.LegalStandard.HasValue || _card.LegalExpanded.HasValue)
                    {
                        <div class="legal-row">
                            @if (_card.LegalStandard.HasValue)
                            {
                                <span class="legal-chip @(_card.LegalStandard.Value ? "legal-chip--legal" : "legal-chip--banned")">
                                    Standard @(_card.LegalStandard.Value ? "✓" : "✗")
                                </span>
                            }
                            @if (_card.LegalExpanded.HasValue)
                            {
                                <span class="legal-chip @(_card.LegalExpanded.Value ? "legal-chip--legal" : "legal-chip--banned")">
                                    Expanded @(_card.LegalExpanded.Value ? "✓" : "✗")
                                </span>
                            }
                        </div>
                    }
                }
            </aside>

            @* ── Right: details ── *@
            <div class="detail-info-col">

                @* Header *@
                <div class="detail-header">
                    <div class="detail-name-row">
                        <h1 class="detail-name">@_entry.CardName</h1>
                        @if (!string.IsNullOrWhiteSpace(_card?.Category))
                        {
                            <span class="ad-chip">@_card.Category</span>
                        }
                    </div>
                    <div class="detail-set-row">
                        @if (!string.IsNullOrWhiteSpace(_card?.SetName))
                        {
                            <span class="detail-set">@_card.SetName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_card?.Number))
                        {
                            <span class="detail-number ad-mono">@_card.Number</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_entry.CardLanguage))
                        {
                            <span class="ad-chip">@_entry.CardLanguage</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_card?.Rarity))
                    {
                        <span class="detail-rarity">@_card.Rarity</span>
                    }
                </div>

                @* ── In your collection ── *@
                <section class="detail-section collection-summary">
                    <h2 class="section-label">In your collection</h2>
                    <div class="collection-stats">
                        <div class="collection-stat">
                            <span class="collection-stat-value">@_entry.Condition</span>
                            <span class="collection-stat-label">Condition</span>
                        </div>
                        <div class="collection-stat collection-stat--accent">
                            <span class="collection-stat-value">@_entry.Quantity</span>
                            <span class="collection-stat-label">Quantity</span>
                        </div>
                    </div>
                    @if (_entry.PurchasePrice.HasValue)
                    {
                        <div class="meta-row"><span class="meta-key">Purchase price</span><span class="meta-val">@_entry.PurchasePrice.Value.ToString("C")</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_entry.StorageLocation))
                    {
                        <div class="meta-row"><span class="meta-key">Storage</span><span class="meta-val">@_entry.StorageLocation</span></div>
                    }
                    <div class="meta-row"><span class="meta-key">Added</span><span class="meta-val">@_entry.DateAdded.ToString("d")</span></div>
                    @if (!string.IsNullOrWhiteSpace(_entry.Notes))
                    {
                        <div class="meta-row"><span class="meta-key">Notes</span><span class="meta-val">@_entry.Notes</span></div>
                    }
                </section>

                @if (_card is not null)
                {
                    @* Pokémon stats *@
                    @if (_card.Hp.HasValue || _card.Types?.Count > 0 || !string.IsNullOrWhiteSpace(_card.Stage))
                    {
                        <section class="detail-section">
                            <h2 class="section-label">Pokémon</h2>
                            <div class="stat-row">
                                @if (_card.Hp.HasValue)
                                {
                                    <div class="stat-item">
                                        <span class="stat-value">@_card.Hp</span>
                                        <span class="stat-label">HP</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_card.Stage))
                                {
                                    <div class="stat-item">
                                        <span class="stat-value">@_card.Stage</span>
                                        <span class="stat-label">Stage</span>
                                    </div>
                                }
                                @if (_card.Retreat.HasValue)
                                {
                                    <div class="stat-item">
                                        <span class="stat-value">@_card.Retreat</span>
                                        <span class="stat-label">Retreat</span>
                                    </div>
                                }
                            </div>
                            @if (_card.Types?.Count > 0)
                            {
                                <div class="type-row">
                                    @foreach (var t in _card.Types)
                                    {
                                        <span class="type-chip type-chip--@t.ToLowerInvariant()">@t</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_card.EvolveFrom))
                            {
                                <p class="evolve-from">Evolves from <strong>@_card.EvolveFrom</strong></p>
                            }
                            @if (_card.DexIds?.Count > 0)
                            {
                                <p class="dex-ids">Pokédex: @string.Join(", ", _card.DexIds.Select(d => $"#{d}"))</p>
                            }
                        </section>
                    }

                    @* Description *@
                    @if (!string.IsNullOrWhiteSpace(_card.Description))
                    {
                        <section class="detail-section">
                            <p class="flavor-text">@_card.Description</p>
                        </section>
                    }

                    @* Attacks *@
                    @if (_card.Attacks?.Count > 0)
                    {
                        <section class="detail-section">
                            <h2 class="section-label">Attacks</h2>
                            <div class="attacks-list">
                                @foreach (var atk in _card.Attacks)
                                {
                                    <div class="attack-card">
                                        <div class="attack-header">
                                            <div class="attack-cost">
                                                @foreach (var c in atk.Cost)
                                                {
                                                    <span class="energy-pip energy-pip--@c.ToLowerInvariant()">@c[..1]</span>
                                                }
                                            </div>
                                            <span class="attack-name">@atk.Name</span>
                                            @if (atk.Damage.HasValue && atk.Damage > 0)
                                            {
                                                <span class="attack-damage">@atk.Damage</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(atk.Effect))
                                        {
                                            <p class="attack-effect">@atk.Effect</p>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* Weaknesses & Resistances *@
                    @if (_card.Weaknesses?.Count > 0 || _card.Resistances?.Count > 0)
                    {
                        <section class="detail-section">
                            <div class="wr-row">
                                @if (_card.Weaknesses?.Count > 0)
                                {
                                    <div>
                                        <h2 class="section-label">Weakness</h2>
                                        <div class="wr-chips">
                                            @foreach (var w in _card.Weaknesses)
                                            {
                                                <span class="wr-chip wr-chip--weak">@w.Type @w.Value</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (_card.Resistances?.Count > 0)
                                {
                                    <div>
                                        <h2 class="section-label">Resistance</h2>
                                        <div class="wr-chips">
                                            @foreach (var r in _card.Resistances)
                                            {
                                                <span class="wr-chip wr-chip--resist">@r.Type @r.Value</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* Metadata *@
                    @if (!string.IsNullOrWhiteSpace(_card.Illustrator) || !string.IsNullOrWhiteSpace(_card.RegulationMark))
                    {
                        <section class="detail-section detail-meta-section">
                            @if (!string.IsNullOrWhiteSpace(_card.Illustrator))
                            {
                                <div class="meta-row"><span class="meta-key">Illustrator</span><span class="meta-val">@_card.Illustrator</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_card.RegulationMark))
                            {
                                <div class="meta-row"><span class="meta-key">Regulation</span><span class="meta-val ad-mono">@_card.RegulationMark</span></div>
                            }
                        </section>
                    }

                    @* Translations *@
                    @if (_card.Translations is { Count: > 0 })
                    {
                        @foreach (var tr in _card.Translations)
                        {
                            <section class="detail-section">
                                <h2 class="section-label">Translation (@tr.Language.ToUpperInvariant())</h2>
                                @if (!string.IsNullOrWhiteSpace(tr.Name))
                                {
                                    <div class="meta-row"><span class="meta-key">Name</span><span class="meta-val">@tr.Name</span></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(tr.Category) || !string.IsNullOrWhiteSpace(tr.Stage))
                                {
                                    <div class="meta-row"><span class="meta-key">Type</span><span class="meta-val">@string.Join(" · ", new[] { tr.Category, tr.Stage }.Where(s => !string.IsNullOrWhiteSpace(s)))</span></div>
                                }
                                @if (tr.Attacks is { Count: > 0 })
                                {
                                    <div class="attacks-list">
                                        @foreach (var atk in tr.Attacks)
                                        {
                                            <div class="attack-card">
                                                <div class="attack-header">
                                                    <span class="attack-name">@atk.Name</span>
                                                    @if (atk.Damage.HasValue && atk.Damage > 0)
                                                    {
                                                        <span class="attack-damage">@atk.Damage</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(atk.Effect))
                                                {
                                                    <p class="attack-effect">@atk.Effect</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    }
                }
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private CollectionEntryDto? _entry;
    private CatalogCardDetail? _card;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _entry = null;
        _card = null;
        try
        {
            _entry = await Http.GetFromJsonAsync<CollectionEntryDto>($"/api/collection/{Id}");
            if (_entry is not null)
            {
                try
                {
                    _card = await Http.GetFromJsonAsync<CatalogCardDetail>($"/api/catalog/cards/{_entry.CardId}");
                }
                catch
                {
                    _card = null;
                }
            }
        }
        catch
        {
            _entry = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/collection");

    private record CollectionEntryDto(Guid Id, Guid CardId, string CardName, string? CardLanguage,
        string Condition, int Quantity, decimal? PurchasePrice, string? StorageLocation,
        string? Notes, string? FrontImageUrl, DateTime DateAdded);
}
