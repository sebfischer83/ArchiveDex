@rendermode InteractiveServer
@inject HttpClient Http
@using System.Net.Http.Json
@using ArchiveDex.Application.Common
@using ArchiveDex.Application.Commands.Collection
@using ArchiveDex.Domain.Enums
@using System.ComponentModel.DataAnnotations

@if (_isVisible)
{
    <div class="ad-dialog-overlay" @onclick="Cancel" @onclick:stopPropagation="true">
        <div class="ad-dialog" @onclick:stopPropagation="true">

            @if (_duplicate is not null)
            {
                <h2 class="ad-dialog__title">Already in Collection</h2>
                <p class="ad-dialog__dup-desc">
                    You already have <strong>@_duplicate.ExistingQuantity</strong> of this card
                    in <strong>@_duplicate.Condition</strong> condition
                    @if (!string.IsNullOrWhiteSpace(_duplicate.StorageLocation))
                    {
                        <span> (@_duplicate.StorageLocation)</span>
                    }.
                </p>
                <p class="ad-dialog__dup-proposal">
                    Add @_duplicate.SubmittedQuantity more for a total of
                    <strong>@_duplicate.ProposedQuantity</strong>?
                </p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="ad-dialog__error">@_error</div>
                }

                <div class="ad-dialog__actions">
                    <button class="ad-btn ad-btn--ghost" type="button"
                            @onclick="CreateSeparate" disabled="@_isSubmitting">
                        Create as Separate Entry
                    </button>
                    <button class="ad-btn ad-btn--primary" type="button"
                            @onclick="MergeQuantity" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Merging…" : "Merge — Increment Quantity")
                    </button>
                </div>
            }
            else
            {
                <h2 class="ad-dialog__title">Add to Collection</h2>

                <EditForm Model="@_model" OnValidSubmit="Submit" class="ad-dialog__form">
                    <DataAnnotationsValidator />

                    <div class="ad-form-group">
                        <label class="ad-form-label">Condition</label>
                        <select class="ad-form-select" @bind="_model.Condition">
                            <option value="NM">NM — Near Mint</option>
                            <option value="LP">LP — Lightly Played</option>
                            <option value="MP">MP — Moderately Played</option>
                            <option value="HP">HP — Heavily Played</option>
                            <option value="DMG">DMG — Damaged</option>
                        </select>
                    </div>

                    <div class="ad-form-group">
                        <label class="ad-form-label">Quantity</label>
                        <input class="ad-form-input" type="number" min="1"
                               @bind="_model.Quantity" @bind:event="oninput" />
                        <ValidationMessage For="@(() => _model.Quantity)" />
                    </div>

                    <div class="ad-form-group">
                        <label class="ad-form-label">Purchase Price (optional)</label>
                        <input class="ad-form-input" type="number" min="0" step="0.01"
                               @bind="_model.PurchasePrice" @bind:event="oninput" />
                        <ValidationMessage For="@(() => _model.PurchasePrice)" />
                    </div>

                    <div class="ad-form-group">
                        <label class="ad-form-label">Storage Location (optional)</label>
                        <input class="ad-form-input" type="text"
                               @bind="_model.StorageLocation" />
                    </div>

                    <div class="ad-form-group">
                        <label class="ad-form-label">Notes (optional)</label>
                        <textarea class="ad-form-textarea" rows="3"
                                  @bind="_model.Notes"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="ad-dialog__error">@_error</div>
                    }

                    <div class="ad-dialog__actions">
                        <button class="ad-btn ad-btn--ghost" type="button"
                                @onclick="Cancel" disabled="@_isSubmitting">
                            Cancel
                        </button>
                        <button class="ad-btn ad-btn--primary" type="submit"
                                disabled="@_isSubmitting">
                            @(_isSubmitting ? "Saving…" : "Save")
                        </button>
                    </div>
                </EditForm>
            }

        </div>
    </div>
}

@code {
    [Parameter] public Guid CardPrintId { get; set; }
    [Parameter] public EventCallback<CollectionEntryDto> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _isVisible;
    private bool _isSubmitting;
    private string? _error;
    private DuplicateDetectedResponse? _duplicate;
    private CreateModel _model = new();

    private sealed class CreateModel
    {
        [Required] public CardCondition Condition { get; set; } = CardCondition.NM;
        [Range(1, int.MaxValue, ErrorMessage = "Quantity must be at least 1.")]
        public int Quantity { get; set; } = 1;
        [Range(0, double.MaxValue, ErrorMessage = "Price must be non-negative.")]
        public decimal? PurchasePrice { get; set; }
        public string? StorageLocation { get; set; }
        public string? Notes { get; set; }
    }

    public void Open()
    {
        _model = new CreateModel();
        _duplicate = null;
        _error = null;
        _isVisible = true;
        StateHasChanged();
    }

    private async Task Cancel()
    {
        _isVisible = false;
        _duplicate = null;
        await OnCancel.InvokeAsync();
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var result = await TryCreate(forceCreate: false, mergeDuplicate: false);
            if (result is not null)
                await OnConfirm.InvokeAsync(result);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task MergeQuantity()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var result = await TryCreate(forceCreate: false, mergeDuplicate: true);
            if (result is not null)
                await OnConfirm.InvokeAsync(result);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CreateSeparate()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var result = await TryCreate(forceCreate: true, mergeDuplicate: false);
            if (result is not null)
                await OnConfirm.InvokeAsync(result);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<CollectionEntryDto?> TryCreate(bool forceCreate, bool mergeDuplicate)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("/api/collection", new
            {
                cardPrintId = CardPrintId,
                condition = _model.Condition.ToString(),
                quantity = _model.Quantity,
                purchasePrice = _model.PurchasePrice,
                storageLocation = _model.StorageLocation,
                notes = _model.Notes,
                forceCreate,
                mergeDuplicate
            });

            if (response.IsSuccessStatusCode)
            {
                _isVisible = false;
                _duplicate = null;
                return await response.Content.ReadFromJsonAsync<CollectionEntryDto>();
            }

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _duplicate = await response.Content.ReadFromJsonAsync<DuplicateDetectedResponse>();
                return null;
            }

            _error = $"Error: {response.StatusCode}";
            return null;
        }
        catch (Exception ex)
        {
            _error = $"Network error: {ex.Message}";
            return null;
        }
    }
}
