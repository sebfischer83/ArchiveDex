<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Old set-mapping generator for the multi-source merge feature. Its source
    projects (ArchiveDex.Limitless / Serebii / Tcgdex) no longer exist, so the
    tool no longer compiles. It is excluded from the build: no source is compiled
    and the dead project references are removed. Program.cs is kept on disk; to
    revive the tool, recreate those projects and restore this file from git-blame
    or set EnableDefaultCompileItems back to true with the references re-added.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
</Project>
