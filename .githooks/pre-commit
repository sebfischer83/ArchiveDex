#!/bin/sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  powershell_command=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell_command=powershell.exe
else
  echo "JPEG metadata guard: PowerShell is required." >&2
  exit 1
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -File scripts/Test-JpegMetadata.ps1 -Staged
