DB_PASSWORD=replace-with-a-long-random-password
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-unique-owner-password
# unavailable, openai, anthropic, openai-batch, anthropic-batch, or fake (development only)
AI_PROVIDER=unavailable
OPENAI_API_KEY=
# OpenAI model (GPT-5 family). Leave unset to use the default (gpt-5.6-luna).
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Anthropic model. Leave unset to use the default (claude-sonnet-4-5).
ANTHROPIC_MODEL=
# Webbasierte Kartenpreise. Derzeit: unavailable oder openai.
VALUATION_PROVIDER=openai
REQUIRE_HTTPS_COOKIES=false
# Maximale komprimierte und entpackte Importgröße in Bytes (Standard: 40 GiB).
DATA_TRANSFER_MAX_ARCHIVE_BYTES=42949672960
